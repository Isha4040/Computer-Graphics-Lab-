#include <GL/glut.h>
#include <cstdlib>
#include <cmath>

int light = 0; 
// 0 = Red, 1 = Yellow, 2 = Green

void drawCircle(float x, float y, float r) {
    glBegin(GL_TRIANGLE_FAN);
    glVertex2f(x, y);

    for (int i = 0; i <= 100; i++) {
        float angle = 2.0f * 3.14159f * i / 100;
        glVertex2f(x + r * cos(angle),
                   y + r * sin(angle));
    }
    glEnd();
}

void display() {
    glClear(GL_COLOR_BUFFER_BIT);

    // Traffic signal body
    glColor3f(0.15f, 0.15f, 0.15f);
    glBegin(GL_QUADS);
        glVertex2f(-0.3f, -0.8f);
        glVertex2f(0.3f, -0.8f);
        glVertex2f(0.3f, 0.8f);
        glVertex2f(-0.3f, 0.8f);
    glEnd();

    // Red light
    if (light == 0)
        glColor3f(1, 0, 0);
    else
        glColor3f(0.25f, 0, 0);
    drawCircle(0, 0.5f, 0.18f);

    // Yellow light
    if (light == 1)
        glColor3f(1, 1, 0);
    else
        glColor3f(0.25f, 0.25f, 0);
    drawCircle(0, 0.0f, 0.18f);

    // Green light
    if (light == 2)
        glColor3f(0, 1, 0);
    else
        glColor3f(0, 0.25f, 0);
    drawCircle(0, -0.5f, 0.18f);

    glFlush();
}

void timer(int value) {
    light = (light + 1) % 3;
    glutPostRedisplay();
    glutTimerFunc(2000, timer, 0);
}

void init() {
    glClearColor(0.7f, 0.8f, 0.9f, 1.0f);
    glMatrixMode(GL_PROJECTION);
    glLoadIdentity();
    gluOrtho2D(-1, 1, -1, 1);
}

int main(int argc, char** argv) {
    glutInit(&argc, argv);
    glutInitDisplayMode(GLUT_SINGLE | GLUT_RGB);
    glutInitWindowSize(600, 600);
    glutCreateWindow("Traffic Light Simulation");

    init();

    glutDisplayFunc(display);
    glutTimerFunc(2000, timer, 0);

    glutMainLoop();
    return 0;
}










